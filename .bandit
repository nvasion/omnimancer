exclude_dirs:
  - tests
  - venv
  - .venv
  - build
  - dist

skips:
  - B101  # assert_used - asserts used in tests and validation
  - B104  # hardcoded_bind_all_interfaces - 0.0.0.0 appears in blocklists, not bind calls
  - B108  # hardcoded_tmp_directory - intentional backup/temp paths
  - B301  # pickle - used for internal response caching
  - B324  # hashlib insecure - MD5 used for cache keys and operation IDs, not security
  - B403  # import_pickle - import-level noise
  - B404  # import_subprocess - import-level noise
  - B601  # paramiko_calls - intentional if used
  - B602  # subprocess_popen_with_shell_equals_true - sandboxed with approval workflow
  - B603  # subprocess_without_shell_equals_false - intentional subprocess usage
